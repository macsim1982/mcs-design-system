# Normalize line endings: the repository always stores LF.
* text=auto eol=lf

# Binary assets (visual regression baselines, images, fonts).
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary

# Generated files: collapsed in diffs and excluded from language statistics.
pnpm-lock.yaml linguist-generated=true -diff
docs/releases/*.md linguist-generated=true
